<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="HabitController"
      alignment="TOP_CENTER"
      spacing="20.0"
      prefWidth="600.0"
      prefHeight="700.0">

    <padding>
        <Insets top="40.0"
                right="40.0"
                bottom="40.0"
                left="40.0"/>
    </padding>

    <Label text="TODAY'S HABITS"
           style="-fx-font-size: 30px; -fx-font-weight: bold;"/>

    <Label text="Complete your habits today"
           style="-fx-font-size: 16px;"/>

    <VBox spacing="15.0">

        <CheckBox fx:id="habit1CheckBox"
                  style="-fx-font-size: 20px;"/>

        <CheckBox fx:id="habit2CheckBox"
                  style="-fx-font-size: 20px;"/>

        <CheckBox fx:id="habit3CheckBox"
                  style="-fx-font-size: 20px;"/>

    </VBox>

    <Button text="Save Today's Habits"
            fx:id="saveButton"
            prefWidth="500.0"
            prefHeight="55.0"
            style="-fx-font-size: 18px;"
            onAction="#handleSave"/>

    <Button text="← Back"
            fx:id="backButton"
            prefWidth="500.0"
            prefHeight="45.0"
            onAction="#handleBack"/>

</VBox>