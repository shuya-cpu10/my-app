<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="MonthlyGoalController"
      alignment="TOP_CENTER"
      spacing="20.0"
      prefWidth="600.0"
      prefHeight="700.0">

    <padding>
        <Insets top="50.0"
                right="50.0"
                bottom="50.0"
                left="50.0"/>
    </padding>

    <Label text="MONTHLY GOAL"
           style="-fx-font-size: 30px; -fx-font-weight: bold;"/>

    <Label fx:id="monthLabel"
           text="This Month"
           style="-fx-font-size: 20px;"/>

    <Label text="What do you want to achieve this month?"
           style="-fx-font-size: 16px;"/>

    <TextField fx:id="goalField"
               promptText="Enter your monthly goal"
               prefWidth="450.0"
               prefHeight="50.0"/>

    <Button text="SAVE MONTHLY GOAL"
            fx:id="saveButton"
            prefWidth="450.0"
            prefHeight="50.0"
            onAction="#handleSave"/>

    <Button text="← Back"
            fx:id="backButton"
            prefWidth="450.0"
            prefHeight="45.0"
            onAction="#handleBack"/>

</VBox>
