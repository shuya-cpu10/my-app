<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="MonthlyGoalCheckController"
      alignment="TOP_CENTER"
      spacing="25.0"
      prefWidth="600.0"
      prefHeight="700.0">

    <padding>
        <Insets top="60.0"
                right="50.0"
                bottom="50.0"
                left="50.0"/>
    </padding>

    <Label text="MONTHLY GOAL CHECK"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <Label fx:id="monthLabel"
           text="September 2026"
           style="-fx-font-size: 20px;"/>

    <Label text="Did you achieve your monthly goal?"
           wrapText="true"
           style="-fx-font-size: 20px;"/>

    <Label fx:id="goalLabel"
           text="No Monthly Goal"
           wrapText="true"
           style="-fx-font-size: 18px;"/>

    <Button text="✓ YES — I ACHIEVED IT"
            fx:id="yesButton"
            prefWidth="450.0"
            prefHeight="55.0"
            onAction="#handleYes"/>

    <Button text="✗ NO — I DID NOT ACHIEVE IT"
            fx:id="noButton"
            prefWidth="450.0"
            prefHeight="55.0"
            onAction="#handleNo"/>

    <Button text="← Back"
            fx:id="backButton"
            prefWidth="450.0"
            prefHeight="45.0"
            onAction="#handleBack"/>

</VBox>