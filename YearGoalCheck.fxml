<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="YearGoalCheckController"
      alignment="CENTER"
      spacing="25.0"
      prefWidth="600.0"
      prefHeight="700.0">

    <padding>
        <Insets top="40.0"
                right="40.0"
                bottom="40.0"
                left="40.0"/>
    </padding>

    <Label text="🎯 YEAR GOAL"
           style="-fx-font-size: 30px; -fx-font-weight: bold;"/>

    <Label text="One year has passed!"
           style="-fx-font-size: 22px;"/>

    <Label text="Did you achieve your Year Goal?"
           style="-fx-font-size: 20px;"/>

    <Label fx:id="yearGoalLabel"
           text="Your Year Goal"
           wrapText="true"
           style="-fx-font-size: 18px;"/>

    <Button text="YES  +1000 XP"
            fx:id="yesButton"
            prefWidth="350.0"
            prefHeight="55.0"
            onAction="#handleYes"/>

    <Button text="NO"
            fx:id="noButton"
            prefWidth="350.0"
            prefHeight="55.0"
            onAction="#handleNo"/>

    <Button text="← Back"
            fx:id="backButton"
            prefWidth="350.0"
            prefHeight="45.0"
            onAction="#handleBack"/>

</VBox>