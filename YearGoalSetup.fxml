<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="YearGoalSetupController"
      alignment="CENTER"
      spacing="25.0"
      prefWidth="600.0"
      prefHeight="700.0">

    <padding>
        <Insets top="40.0"
                right="40.0"
                bottom="40.0"
                left="40.0"/>
    </padding>

    <Label text="🎯 YEAR GOAL"
           style="-fx-font-size: 30px; -fx-font-weight: bold;"/>

    <Label text="What do you want to achieve in one year?"
           style="-fx-font-size: 20px;"/>

    <TextField fx:id="yearGoalField"
               promptText="Enter your Year Goal"
               prefWidth="450.0"
               prefHeight="50.0"/>

    <Button text="SAVE YEAR GOAL"
            fx:id="saveButton"
            prefWidth="350.0"
            prefHeight="55.0"
            onAction="#handleSave"/>

    <Button text="← Back"
            fx:id="backButton"
            prefWidth="350.0"
            prefHeight="45.0"
            onAction="#handleBack"/>

</VBox>